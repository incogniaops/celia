# Copy to .env for local (non-container) development, and for compose.yaml
# to pick up via its ${VAR} interpolation (compose reads a project-root
# .env automatically; this file is committed as a template only).
DATABASE_URL=postgresql+psycopg://celia:celia@localhost:5432/celia

# From the OAuth client at .secrets/client_secret_*.json ("web" key).
# Authorized redirect URIs on that client must include this app's own
# callback (http://localhost:8000/auth/google/callback for local dev, plus
# the homelab's https://celia.faraday.org/auth/google/callback) -- added
# once, manually, in Google Cloud Console (no public API for this).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

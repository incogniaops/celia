\usepackage[most]{tcolorbox}
\usepackage{fontspec}
% Latin Modern Sans, loaded by exact bundled .otf filename rather than by
% font name -- this sandboxed build has no system fontconfig database for
% fontspec's usual by-name lookup (confirmed empirically: \setmainfont{Latin
% Modern Sans} fails with "cannot be found" even though the files exist and
% Tectonic fetches them fine by literal filename via kpathsea).
\setmainfont{lmsans10-regular.otf}[
  UprightFont = *,
  BoldFont = lmsans10-bold.otf,
  ItalicFont = lmsans10-oblique.otf,
  BoldItalicFont = lmsans10-boldoblique.otf,
]
\pagestyle{empty}
\setlength{\parindent}{0pt}

% Abbott/LibreView-style shaded panel, used for every section below (see
% design.md) -- light grey background, no visible border, bold left-aligned
% title, rounded corners.
\tcbset{
  panel/.style={
    colback=gray!6, colframe=gray!6, coltitle=black,
    fonttitle=\bfseries, boxrule=0pt, arc=1.5mm,
    left=4mm, right=4mm, top=2mm, bottom=3mm,
  }
}

